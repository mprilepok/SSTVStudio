<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SstvStudio.Views.SplashWindow"
        Title="SSTV Studio"
        Icon="/Assets/app.ico"
        Width="560" Height="330"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <Border CornerRadius="14" Background="#1E1E2E" BorderBrush="#45475A" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <Grid ColumnDefinitions="Auto,*" Margin="34,34,34,10">
                <Image Source="/Assets/logo.png" Width="112" Height="112" VerticalAlignment="Top"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="26,6,0,0">
                    <TextBlock Text="SSTV Studio" FontSize="34" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Slow-scan TV transmitter &amp; receiver" FontSize="15" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                    <TextBlock Text="Hamlib rig control · Wavelog logging" FontSize="13" Foreground="#7F849C" Margin="0,2,0,0"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#89B4FA" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="34,0,34,0">
                <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" Foreground="#89B4FA" Background="#313244"
                             CornerRadius="2"/>
                <!-- SSTV colour-bar strip -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" Height="6" Margin="-34,22,-34,0">
                    <Border Grid.Column="0" Background="#FFFFFF"/>
                    <Border Grid.Column="1" Background="#F9E2AF"/>
                    <Border Grid.Column="2" Background="#89DCEB"/>
                    <Border Grid.Column="3" Background="#A6E3A1"/>
                    <Border Grid.Column="4" Background="#CBA6F7"/>
                    <Border Grid.Column="5" Background="#F38BA8"/>
                    <Border Grid.Column="6" Background="#89B4FA"/>
                    <Border Grid.Column="7" Background="#11111B"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
